<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ported from .NET Framework 4.7.2 / MelonLoader 0.5 to net6 / MelonLoader 0.7.2 for TLD 2.55 (Unity 6). -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>Latest</LangVersion>
    <RootNamespace>SkyCoop</RootNamespace>
    <AssemblyName>SkyCoop</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Configurations>Debug;Release;Dedicated;Dedicated Linux</Configurations>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0219;CS0414;CS0649;CS0169;CS0618;CS0612</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Dedicated'">
    <DefineConstants>DEDICATED</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Dedicated Linux'">
    <DefineConstants>DEDICATED;DEDICATED_LINUX</DefineConstants>
  </PropertyGroup>

  <!-- Game install with MelonLoader 0.7.2 that has generated Il2CppAssemblies. Override with /p:TLDPath=... -->
  <PropertyGroup>
    <TLDPath Condition="'$(TLDPath)' == ''">E:\Programs\Steam\steamapps\common\TheLongDark</TLDPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.2" ExcludeAssets="runtime" />
    <PackageReference Include="HarmonyX" Version="2.10.2" ExcludeAssets="runtime" />
    <PackageReference Include="Il2CppInterop.Runtime" Version="1.5.1" ExcludeAssets="runtime" />
    <!-- Matches the game's steam_api64 (SDK 1.51: SteamUser021/SteamFriends017). Ship runtimes/win-x64 dll to UserLibs. -->
    <PackageReference Include="Steamworks.NET" Version="15.0.1" />
    <Reference Include="$(TLDPath)\MelonLoader\Il2CppAssemblies\*.dll" Private="false" />
    <!-- Unity editor scripts and build outputs, not part of the mod. -->
    <Compile Remove="Tools/**;dist/**" />
  </ItemGroup>
</Project>
